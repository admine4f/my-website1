# =====================================================================
# E4F Web3 Exchange - Production Environment Configuration Template
# File: .env.example
# Copy this file to .env.local (or configure in Vercel Project Settings)
# NEVER commit real secret keys to public git repositories!
# =====================================================================

# 1. Supabase Database & Service Role Keys (Server-Side ONLY)
# CRITICAL SECURITY RULE: SUPABASE_SERVICE_ROLE_KEY must NEVER be prefixed with
# NEXT_PUBLIC_ or VITE_ or exposed to the client bundle!
# This secret key is strictly for server-side usage in lib/telegramAuth.js and server.ts.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 2. Telegram Bot Token (Used exclusively on backend to verify WebApp initData HMAC-SHA256 signature)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# 3. Administrator Secret Key (Never exposed in frontend; used to authenticate /api/admin/*)
ADMIN_SECRET="your-super-strong-admin-password-minimum-16-chars"

# 4. Session Token Signing Secret (Used by backend to sign and verify user auth tokens)
SESSION_SECRET="your-long-random-hex-string-for-session-tokens"

# 5. Blockchain Node / RPC URL (Optional - for on-chain TXID confirmation)
# BLOCKCHAIN_RPC_URL="https://bsc-dataseed.binance.org"

# 6. AI Studio / Gemini API (Injected automatically in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
